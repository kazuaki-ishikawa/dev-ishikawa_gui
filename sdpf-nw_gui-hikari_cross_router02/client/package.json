{
  "name": "sdpf",
  "private": true,
  "scripts": {
    "clean": "nuxt cleanup",
    "start": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "cy:open": "cypress open --e2e --config \"baseUrl=${BASE_URL:-http://localhost:8080},specPattern=${SPEC:-cypress/e2e/**/*.cy.ts}\"",
    "cy:run": "rimraf cypress/screenshots && cypress-parallel -s cy:serial -t 4 -d \"${SPEC:-cypress/e2e/**/*.cy.ts}\"",
    "cy:serial": "rimraf cypress/screenshots && cypress run --e2e --config \"baseUrl=${BASE_URL:-http://localhost:8080}\" --spec \"${SPEC:-cypress/e2e/**/*.cy.ts}\"",
    "test": "start-server-and-test start http://localhost:8080 cy:open",
    "test:nova": "BASE_URL=http://localhost:8080/nova SPEC='cypress/e2e/**/*.cy.nova.ts' npm run test",
    "test:e2e": "start-server-and-test start http://localhost:8080 cy:run",
    "test:e2e:nova": "BASE_URL=http://localhost:8080/nova SPEC='cypress/e2e/**/*.cy.nova.ts' npm run test:e2e",
    "test:serial": "start-server-and-test start http://localhost:8080 cy:serial",
    "test:serial:nova": "BASE_URL=http://localhost:8080/nova SPEC='cypress/e2e/**/*.cy.nova.ts' npm run test:serial"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^13.0.0",
    "dayjs": "^1.11.19",
    "es-toolkit": "^1.45.0",
    "highcharts": "12.4.0",
    "highcharts-vue": "^2.0.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.0.0",
    "mitt": "^3.0.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "svg2pdf.js": "^2.7.0",
    "vue-i18n": "^11.2.8"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxt/eslint": "^1.16.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^25.3.3",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "cypress": "^15.15.0",
    "cypress-parallel": "^0.15.0",
    "dotenv-flow": "^4.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.4.0",
    "markdown-it": "^14.2.0",
    "markdown-it-link-attributes": "^4.0.1",
    "nuxt": "^4.4.8",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.97.3",
    "start-server-and-test": "^2.1.5",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vue-tsc": "^3.3.8",
    "vuetify": "^4.1.2",
    "vuetify-nuxt-module": "^1.0.0-rc.1"
  },
  "overrides": {
    "@bomb.sh/tab": "0.0.14",
    "glob": "13.0.6"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid"
  }
}
